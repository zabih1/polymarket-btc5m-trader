[Unit]
Description=BTC 5M Sim Trader (Backtest & Simulation)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/polymarket-btc5m-trader/btc5m-trader/sim/trader.py
Restart=on-failure
RestartSec=10
WorkingDirectory=%h/polymarket-btc5m-trader/btc5m-trader

[Install]
WantedBy=default.target
