# Polymarket wallet credentials
# WARNING: enter your private key (without the 0x prefix)
PRIVATE_KEY=
# Wallet address
FUNDER_ADDRESS=

# Strategy parameters
GAP_THRESHOLD=10
PROB_THRESHOLD=0.60
ENTRY_SECOND=5
BET_FRACTION=0.25
WITHDRAW_AT=2.0

# Mode: sim=simulation, live=real money
MODE=sim

